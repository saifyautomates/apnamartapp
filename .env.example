# Database (PostgreSQL) — connects to Supabase PostgreSQL or local Docker PostgreSQL
# For Supabase (Session Pooler): postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# For Supabase (Direct Connection): postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://grocery_app:CHANGE_ME@localhost:5432/grocery_commerce?schema=public"

# Supabase (Database, Auth, Storage & Realtime)
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
SUPABASE_STORAGE_BUCKET="centralmart-media"

# Auth (generate long random strings for production; never commit real values)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"

# Admin seed account: created by `npm run seed` ONLY when ADMIN_PASSWORD is set.
# Never hardcode a password in code. First boot without ADMIN_PASSWORD uses /api/auth/setup.
ADMIN_USERNAME="saif"
ADMIN_PASSWORD=""

# App
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Builds and production runs REQUIRE production. `next dev` sets development
# automatically, so local development (including the dev-OTP shortcut, which
# only works when NODE_ENV != production) is unaffected. Never ship a deploy
# .env with NODE_ENV=development: it breaks `npm run build` and leaves
# dev-only endpoints enabled.
NODE_ENV="production"
# OTP in development only: when "true" AND NODE_ENV != production, /api/auth/request-otp
# returns devOtp in the response so automated tests can verify without an SMS provider.
# NEVER enable this in production.
ALLOW_DEV_OTP="false"
# Secret for unattended cron calls to POST /api/jobs/expire-reservations
# (x-cron-secret header). Without it, that route requires an admin session.
CRON_SECRET=""

# Redis (optional; app falls back to in-memory cache + in-memory rate limits if unset)
REDIS_URL=""

# S3-compatible storage (optional; falls back to local ./public/uploads when unset)
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Payment gateway (v1: COD + dev-only mock gateway; wire a real provider here later)
# Webhook HMAC secret for the real provider's signed webhooks.
PAYMENT_WEBHOOK_SECRET=""

# ============================================================================
# LIVE PRODUCTION NOTIFICATIONS & COMMUNICATIONS
# ============================================================================

# 1. RESEND (Email Delivery for Order Invoices, Welcome, Admin Alerts)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Central Mart <orders@centralmart.in>"

# 2. MSG91 (SMS OTP, WhatsApp Order Updates, Text Messages for India +91)
# Get your AuthKey from MSG91 Dashboard -> AuthKey
MSG91_AUTH_KEY=""
# DLT Approved OTP Template ID (MSG91 -> OTP -> Templates)
MSG91_OTP_TEMPLATE_ID=""
# 6-character Sender ID approved on DLT (e.g. CNTRLM)
MSG91_SENDER_ID="CNTRLM"

# MSG91 WhatsApp Integration (MSG91 -> WhatsApp)
# Your WhatsApp Business Verified Integrated Number (e.g. 919876543210)
MSG91_WHATSAPP_INTEGRATED_NUMBER=""
# Approved WhatsApp Template Name (e.g. centralmart_order_update)
MSG91_WHATSAPP_ORDER_TEMPLATE="centralmart_order_update"

# MSG91 Transactional Text SMS Flow ID (MSG91 -> Flow)
MSG91_SMS_FLOW_ID=""

# BUSY / Shiprocket: NOT connected in v1 by design. Leave empty.
BUSY_API_URL=""
BUSY_API_KEY=""
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
