# Database (PostgreSQL) — the only URL Prisma reads
DATABASE_URL="postgresql://grocery_app:CHANGE_ME@localhost:5432/grocery_commerce?schema=public"

# Auth (generate long random strings for production; never commit real values)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"

# Admin seed account: created by `npm run seed` ONLY when ADMIN_PASSWORD is set.
# Never hardcode a password in code. First boot without ADMIN_PASSWORD uses /api/auth/setup.
ADMIN_USERNAME="saif"
ADMIN_PASSWORD=""

# App
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Builds and production runs REQUIRE production. `next dev` sets development
# automatically, so local development (including the dev-OTP shortcut, which
# only works when NODE_ENV != production) is unaffected. Never ship a deploy
# .env with NODE_ENV=development: it breaks `npm run build` and leaves
# dev-only endpoints enabled.
NODE_ENV="production"
# OTP in development only: when "true" AND NODE_ENV != production, /api/auth/request-otp
# returns devOtp in the response so automated tests can verify without an SMS provider.
# NEVER enable this in production.
ALLOW_DEV_OTP="false"
# Secret for unattended cron calls to POST /api/jobs/expire-reservations
# (x-cron-secret header). Without it, that route requires an admin session.
CRON_SECRET=""

# Redis (optional; app falls back to in-memory cache + in-memory rate limits if unset)
REDIS_URL=""

# S3-compatible storage (optional; falls back to local ./public/uploads when unset)
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Payment gateway (v1: COD + dev-only mock gateway; wire a real provider here later)
# Webhook HMAC secret for the real provider's signed webhooks.
PAYMENT_WEBHOOK_SECRET=""

# Notifications (v1: console provider logs; plug SMS/WhatsApp/Email providers later)
SMS_PROVIDER=""
WHATSAPP_PROVIDER=""
EMAIL_SMTP_URL=""

# BUSY / Shiprocket: NOT connected in v1 by design. Leave empty.
BUSY_API_URL=""
BUSY_API_KEY=""
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
